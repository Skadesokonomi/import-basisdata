<dbmodel pgmodeler-ver="1.1.3" use-changelog="false" max-obj-count="10"
	 last-position="0,0" last-zoom="1"
	 default-schema="public" default-owner="postgres"
	 layers="Default layer"
	 active-layers="0"
	 layer-name-colors="#000000"
	 layer-rect-colors="#b4b4b4"
	 show-layer-names="false" show-layer-rects="false">
<database name="tgv" encoding="UTF8" lc-collate="English_Denmark.1252" lc-ctype="English_Denmark.1252" is-template="false" allow-conns="true">
	<role name="postgres"/>
	<tablespace name="pg_default"/>
</database>

<schema name="public" layers="0" rect-visible="true" fill-color="#e1e1e1" name-color="#000000" sql-disabled="true">
</schema>

<schema name="fdc_tgv_data" layers="0" rect-visible="true" fill-color="#ffffff" name-color="#000000">
	<role name="postgres"/>
</schema>

<schema name="fdc_tgv_functions" layers="0" rect-visible="true" fill-color="#c5713c" name-color="#000000">
	<role name="postgres"/>
</schema>

<table name="tgv_models" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
