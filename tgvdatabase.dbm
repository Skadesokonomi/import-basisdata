	</column>
	<column name="parameter_2" not-null="true">
		<type name="double precision" length="0"/>
	</column>
	<constraint name="tgv_models_model_name_key" type="uq-constr" table="fdc_tgv_data.tgv_models">
		<columns names="model_name" ref-type="src-columns"/>
	</constraint>
	<constraint name="tgv_models_pkey" type="pk-constr" table="fdc_tgv_data.tgv_models">
		<columns names="model_id" ref-type="src-columns"/>
	</constraint>
</table>

