<constraint name="fk_tgv_models_projects" type="fk-constr" comparison-type="MATCH SIMPLE"
	 upd-action="NO ACTION" del-action="NO ACTION" ref-table="fdc_tgv_data.tgv_projects" table="fdc_tgv_data.tgv_models">
	<columns names="project_id" ref-type="src-columns"/>
	<columns names="project_id" ref-type="dst-columns"/>
